# Copia a .env y rellena. .env NO se versiona.
#   cp .env.example .env

# --- OpenAI: capa de lenguaje natural (Fase 5) ------------------------------
# Sin esta clave la API arranca igual; solo /ask devuelve 503.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- MariaDB ----------------------------------------------------------------
# Credenciales de desarrollo. El servicio no publica puerto en el host, pero
# aun asi no tienen por que vivir en compose.yaml.
MARIADB_DATABASE=scoutvec
MARIADB_USER=scoutvec
MARIADB_PASSWORD=cambia-esto
MARIADB_ROOT_PASSWORD=cambia-esto-tambien

# --- Login ------------------------------------------------------------------
# El seed crea este usuario si no existe, con la clave marcada para cambiar
# en el primer acceso. Deja ADMIN_INITIAL_PASSWORD vacio si ya lo creaste.
ADMIN_USER=tu-usuario
ADMIN_INITIAL_PASSWORD=
# auto = se deduce de X-Forwarded-Proto; true o false para forzarlo
SESSION_COOKIE_SECURE=auto

# --- Puerto publicado -------------------------------------------------------
# El unico que se expone al host. Comprueba antes: python preflight.py
FRONTEND_PORT=8090
